<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarPomodoro"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:navigationIconTint="@color/text_primary"
        app:titleTextColor="@color/text_primary"
        app:elevation="1dp"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/pomodoro_title"
        app:titleCentered="true"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp">

            <!-- Thẻ gắn kết Task đang tập trung -->
            <!--            <com.google.android.material.card.MaterialCardView-->
            <!--                android:id="@+id/cardFocusTask"-->
            <!--                android:layout_width="match_parent"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:layout_marginBottom="24dp"-->
            <!--                app:cardCornerRadius="14dp"-->
            <!--                app:cardElevation="0dp"-->
            <!--                app:strokeColor="#E0E0E0"-->
            <!--                app:strokeWidth="1dp">-->

            <!--&lt;!&ndash;                <LinearLayout&ndash;&gt;-->
            <!--&lt;!&ndash;                    android:layout_width="match_parent"&ndash;&gt;-->
            <!--&lt;!&ndash;                    android:layout_height="wrap_content"&ndash;&gt;-->
            <!--&lt;!&ndash;                    android:gravity="center_vertical"&ndash;&gt;-->
            <!--&lt;!&ndash;                    android:orientation="horizontal"&ndash;&gt;-->
            <!--&lt;!&ndash;                    android:padding="12dp">&ndash;&gt;-->

            <!--&lt;!&ndash;                    <TextView&ndash;&gt;-->
            <!--&lt;!&ndash;                        android:id="@+id/tvFocusTaskTitle"&ndash;&gt;-->
            <!--&lt;!&ndash;                        android:layout_width="0dp"&ndash;&gt;-->
            <!--&lt;!&ndash;                        android:layout_height="wrap_content"&ndash;&gt;-->
            <!--&lt;!&ndash;                        android:layout_weight="1"&ndash;&gt;-->
            <!--&lt;!&ndash;                        android:ellipsize="end"&ndash;&gt;-->
            <!--&lt;!&ndash;                        android:maxLines="1"&ndash;&gt;-->
            <!--&lt;!&ndash;                        android:text="@string/pomodoro_general_focus"&ndash;&gt;-->
            <!--&lt;!&ndash;                        android:textColor="@android:color/black"&ndash;&gt;-->
            <!--&lt;!&ndash;                        android:textSize="14sp"&ndash;&gt;-->
            <!--&lt;!&ndash;                        android:textStyle="bold" />&ndash;&gt;-->

            <!--&lt;!&ndash;                    <com.google.android.material.button.MaterialButton&ndash;&gt;-->
            <!--&lt;!&ndash;                        android:id="@+id/btnCompleteTaskFromPomodoro"&ndash;&gt;-->
            <!--&lt;!&ndash;                        style="?attr/materialButtonOutlinedStyle"&ndash;&gt;-->
            <!--&lt;!&ndash;                        android:layout_width="wrap_content"&ndash;&gt;-->
            <!--&lt;!&ndash;                        android:layout_height="36dp"&ndash;&gt;-->
            <!--&lt;!&ndash;                        android:paddingHorizontal="10dp"&ndash;&gt;-->
            <!--&lt;!&ndash;                        android:text="@string/pomodoro_btn_complete_task"&ndash;&gt;-->
            <!--&lt;!&ndash;                        android:textSize="12sp"&ndash;&gt;-->
            <!--&lt;!&ndash;                        android:visibility="gone" />&ndash;&gt;-->
            <!--&lt;!&ndash;                </LinearLayout>&ndash;&gt;-->
            <!--            </com.google.android.material.card.MaterialCardView>-->

            <!-- Vòng tròn tiến trình Pomodoro -->
            <FrameLayout
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="center">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/circularTimerProgress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    app:indicatorColor="#FF5722"
                    app:indicatorSize="260dp"
                    app:trackColor="#EEEEEE"
                    app:trackCornerRadius="8dp"
                    app:trackThickness="12dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/pomodoro_focus_mode"
                        android:textColor="#FF5722"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="4dp"
                        android:text="25:00"
                        android:textColor="@color/text_primary"
                        android:textSize="54sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCycleCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 / 4"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>


            <!-- Cụm nút điều khiển chính -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReset"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:singleLine="true"
                    android:text="@string/btn_reset"
                    android:textColor="@color/brand_primary"
                    android:textSize="12sp"
                    app:strokeColor="@color/outline"
                    app:cornerRadius="26dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartPause"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1.4"
                    android:layout_marginHorizontal="4dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:singleLine="true"
                    android:backgroundTint="@color/brand_primary"
                    android:text="@string/pomodoro_btn_start"
                    android:textColor="@color/on_brand"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="26dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSkip"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:singleLine="true"
                    android:text="@string/pomodoro_btn_skip"
                    android:textColor="@color/brand_primary"
                    android:textSize="12sp"
                    app:strokeColor="@color/outline"
                    app:cornerRadius="26dp" />

            </LinearLayout>


            <!-- Cài đặt thời lượng Tập trung -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/focus_label"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWork15"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="0dp"
                    android:text="15m"
                    android:textColor="@color/brand_primary"
                    app:strokeColor="@color/outline"
                    app:cornerRadius="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWork25"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="0dp"
                    android:text="25m"
                    android:textColor="@color/brand_primary"
                    app:strokeColor="@color/outline"
                    app:cornerRadius="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWork45"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="0dp"
                    android:text="45m"
                    android:textColor="@color/brand_primary"
                    app:strokeColor="@color/outline"
                    app:cornerRadius="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWorkCustom"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="0dp"
                    android:text="@string/btn_custom"
                    android:textSize="12sp"
                    android:textColor="@color/brand_primary"
                    app:strokeColor="@color/outline"
                    app:cornerRadius="20dp" />
            </LinearLayout>

            <!-- Cài đặt thời lượng Nghỉ ngơi -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/break_label"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBreak5"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="0dp"
                    android:text="5m"
                    android:textColor="@color/brand_primary"
                    app:strokeColor="@color/outline"
                    app:cornerRadius="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBreak10"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="0dp"
                    android:text="10m"
                    android:textColor="@color/brand_primary"
                    app:strokeColor="@color/outline"
                    app:cornerRadius="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBreak15"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="0dp"
                    android:text="15m"
                    android:textColor="@color/brand_primary"
                    app:strokeColor="@color/outline"
                    app:cornerRadius="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBreakCustom"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="0dp"
                    android:text="@string/btn_custom"
                    android:textSize="12sp"
                    android:textColor="@color/brand_primary"
                    app:strokeColor="@color/outline"
                    app:cornerRadius="20dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
